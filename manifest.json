{
    "manifest_version": 3,
    "name": "Lichess Ravamped",
    "version": "0.1.0",
    "description": "Custom Styles and Board vision for Lichess",
    "action": {
        "default_popup": "popup.html"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://lichess.org/*"
            ],
        "js": ["content.js"],
        "css": ["content.css"],
        "run_at": "document_idle"
    }
]
}